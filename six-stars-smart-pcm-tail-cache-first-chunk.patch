     void beginPreparedPrefix() { playbackQueue.beginPreparedPrefix(); }
-    void enqueuePreparedPrefix(ArrayList<PhoneVoiceClip> clips) { playbackQueue.enqueuePreparedPrefix(clips); }
+    void enqueuePreparedPrefix(ArrayList<PhoneVoiceClip> clips) {
+        playbackQueue.enqueuePreparedPrefix(coalescePreparedPrefix(clips));
+    }
+
+    private ArrayList<PhoneVoiceClip> coalescePreparedPrefix(ArrayList<PhoneVoiceClip> clips) {
+        if (clips == null || clips.size() < 2) return clips == null ? new ArrayList<>() : clips;
+
+        try {
+            PhoneVoiceClip first = clips.get(0);
+            if (first == null || first.continuousPcm || first.wav.length == 0) return clips;
+
+            ParsedWav format = ParsedWav.parse(first.wav);
+            ByteArrayOutputStream pcm = new ByteArrayOutputStream();
+            ArrayList<Runnable> completions = new ArrayList<>();
+
+            for (PhoneVoiceClip clip : clips) {
+                if (clip == null || clip.continuousPcm || clip.wav.length == 0) return clips;
+                ParsedWav parsed = ParsedWav.parse(clip.wav);
+                if (parsed.sampleRate != format.sampleRate || parsed.channels != format.channels) {
+                    post(() -> listener.onDebug(
+                            "Cached voice kept as separate clips",
+                            "Prepared WAV formats did not match, so playback was not coalesced."));
+                    return clips;
+                }
+
+                pcm.write(parsed.pcm, 0, parsed.pcm.length);
+                if (clip.onCompleted != null) completions.add(clip.onCompleted);
+            }
+
+            byte[] combinedPcm = pcm.toByteArray();
+            if (combinedPcm.length == 0) return clips;
+
+            byte[] combinedWav = VoiceCaptureService.wavFromPcm16(
+                    combinedPcm, format.sampleRate, format.channels);
+            PcmSpeechActivityAnalyzer.Analysis activity =
+                    PcmSpeechActivityAnalyzer.analyzePcm16(
+                            combinedPcm, format.sampleRate, format.channels);
+
+            long frames = combinedPcm.length / Math.max(1L, format.channels * 2L);
+            long durationMs = frames * 1000L / Math.max(1, format.sampleRate);
+
+            Runnable completion = completions.isEmpty() ? null : () -> {
+                for (Runnable callback : completions) {
+                    try { callback.run(); } catch (Throwable ignored) { }
+                }
+            };
+
+            PhoneVoiceClip merged = new PhoneVoiceClip(
+                    combinedWav,
+                    first.label + " cached sequence",
+                    "",
+                    first.fromDesktop,
+                    first.streamId,
+                    first.streamOrdinal,
+                    first.audioSequence,
+                    activity.segmentsMs,
+                    false,
+                    0,
+                    "",
+                    durationMs,
+                    completion);
+
+            ArrayList<PhoneVoiceClip> result = new ArrayList<>();
+            result.add(merged);
+            int clipCount = clips.size();
+            post(() -> listener.onDebug(
+                    "Cached voice coalesced",
+                    "Joined " + clipCount + " prepared WAV fragments into one "
+                            + durationMs + "ms continuous local playback clip."));
+            return result;
+        } catch (Throwable error) {
+            post(() -> listener.onDebug(
+                    "Cached voice coalesce skipped",
+                    "Could not join prepared WAV fragments; using the original queue: "
+                            + error.getMessage()));
+            return clips;
+        }
+    }
+
     void cancelPreparedPrefix() { playbackQueue.cancelPreparedPrefix(); }
