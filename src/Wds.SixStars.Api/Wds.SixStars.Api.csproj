<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Wds.SixStars.Api</AssemblyName>
    <RootNamespace>Wds.SixStars.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Scriban" Version="7.2.5" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Content\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\VoiceClones\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\LoreLibrary\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\PromptTemplates\**\*.sbn" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
