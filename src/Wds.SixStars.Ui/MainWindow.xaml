<Window x:Class="Wds.SixStars.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Six Stars Dev Harness" Height="900" Width="1320"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.15*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Star" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding StarIds}" SelectedItem="{Binding SelectedStarId}" Width="140" Margin="0,0,16,0" />
                    <TextBlock Text="Request" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding RequestTypes}" SelectedItem="{Binding SelectedRequestType}" Width="140" Margin="0,0,16,0" />
                    <CheckBox Content="Romance Mode" IsChecked="{Binding RomanceMode}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Content="Met" IsChecked="{Binding SelectedStarIsMet}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Content="Ally" IsChecked="{Binding SelectedStarIsAlly}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Area" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="0,0,16,0" />
                    <TextBlock Text="Quest" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Quest, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="0.9*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Message To Selected Star — default companion mode">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Type normal chat here: hi, work banter, poetry about her eyes, moral questions, romance tests, or anything the Last Cat says. Click Send Message for plain chat."
                                   TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6" />
                        <TextBox Text="{Binding PlayerText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="15"
                                 Padding="10" />
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Optional Story Suggestion">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="When you click Tell Me A Story, this optional seed is sent as StoryOptions.PlayerSuggestion. Leave it blank and she chooses her own story."
                                   TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6" />
                        <TextBox Text="{Binding StorySuggestion, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="14"
                                 Padding="10" />
                    </DockPanel>
                </GroupBox>
            </Grid>

            <GroupBox Grid.Column="2" Header="Quick Actions / Test Buttons">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="Primary" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Button Content="Send Message" Command="{Binding SendMessageCommand}" Margin="0,0,0,8" Height="36" />
                    <Button Content="Tell Me A Story" Command="{Binding TellStoryCommand}" Margin="0,0,0,8" Height="36" />
                    <Button Content="Interrupt Story" Command="{Binding InterruptStoryCommand}" Margin="0,0,0,8" Height="34" />
                    <Button Content="Clear Selected Star History" Command="{Binding ClearSelectedStarHistoryCommand}" Margin="0,0,0,8" Height="34" />
                    <TextBlock Text="Send Message keeps RequestType=Chat. Tell Me A Story sets RequestType=Story and sends the optional story suggestion above. Interrupt Story stops local cached story autoplay. Clear Selected Star History resets the local memory/relationship state for the selected Star." TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8" />
                    <Separator Margin="0,8,0,8" />
                    <TextBlock Text="Scenario Tests" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Button Content="Goblin / Harpy Discernment" Command="{Binding GoblinHarpiesCommand}" Margin="0,0,0,8" Height="34" />
                    <Button Content="Cruel Escalation Test" Command="{Binding CruelEscalationCommand}" Margin="0,0,0,8" Height="34" />
                    <Button Content="Kind Company Test" Command="{Binding KindCompanyCommand}" Margin="0,0,0,8" Height="34" />
                    <Separator Margin="0,8,0,8" />
                    <TextBlock Text="Android Phone Bridge" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border BorderBrush="#D9E3F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8" Background="#FAFCFF">
                        <StackPanel>
                            <TextBlock Text="Host a tiny LAN server so the Android app can send text or recorded voice to this desktop runtime. Spoken Star WAV chunks stream back to the phone over a lightweight TCP audio socket on the next port. The phone defaults to http://grasshoppah:8066." TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding MobileBridgeHostName, UpdateSourceTrigger=PropertyChanged}" Width="96" Margin="0,0,8,0" />
                                <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding MobileBridgePort, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                            </StackPanel>
                            <TextBlock Text="{Binding MobileBridgeUrl}" FontFamily="Consolas" Foreground="#333" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding MobileBridgeAudioUrl}" FontFamily="Consolas" Foreground="#555" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Start Host" Command="{Binding StartMobileBridgeCommand}" Width="92" Height="30" Margin="0,0,6,0" />
                                <Button Content="Stop" Command="{Binding StopMobileBridgeCommand}" Width="64" Height="30" />
                            </StackPanel>
                            <CheckBox Content="Mobile bridge running" IsChecked="{Binding MobileBridgeEnabled}" IsEnabled="False" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding MobileBridgeStatus}" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,6" />
                            <TextBlock Text="Last phone request" FontWeight="SemiBold" />
                            <TextBox Text="{Binding MobileBridgeLastRequest}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="48" MaxHeight="86" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Voice Input / Whisper" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border BorderBrush="#D9E3F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8" Background="#FAFCFF">
                        <StackPanel>
                            <CheckBox Content="Require selected Star name in transcript after Whisper" IsChecked="{Binding SpeechRequireWakeWord}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Start Listen" Command="{Binding StartListeningCommand}" Width="92" Height="30" Margin="0,0,6,0" />
                                <Button Content="Stop" Command="{Binding StopListeningCommand}" Width="64" Height="30" Margin="0,0,6,0" />
                                <Button Content="Simulate Text" Command="{Binding SimulateSpeechCommand}" Width="98" Height="30" />
                            </StackPanel>
                            <TextBlock Text="Always-listening mode uses simple amplitude VAD: sound starts a segment, silence submits it to Whisper. OpenWakeWord is not used." TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8" />
                            <TextBlock Text="Live Input Level" FontWeight="SemiBold" />
                            <ProgressBar Value="{Binding IncomingVoiceLevelPercent}" Maximum="100" Height="14" Margin="0,4,0,4" />
                            <TextBlock Text="{Binding IncomingVoiceDebug}" TextWrapping="Wrap" Foreground="#555" FontFamily="Consolas" FontSize="11" Margin="0,0,0,6" />
                            <TextBlock Text="Mic" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MicrophoneCaptureStatus}" TextWrapping="Wrap" Foreground="#555" Margin="0,2,0,6" />
                            <TextBlock Text="Voice Pipeline" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VoiceInputStatus}" TextWrapping="Wrap" Foreground="#555" Margin="0,2,0,6" />
                            <TextBlock Text="Last Segment" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LastVoiceSegmentDetails}" TextWrapping="Wrap" Foreground="#555" Margin="0,2,0,6" />
                            <TextBlock Text="Last Transcript" FontWeight="SemiBold" />
                            <TextBox Text="{Binding LastTranscript}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="48" MaxHeight="90" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" Width="210" Height="34" Margin="0,0,6,0" />
                        <Button Content="{Binding CancelStopButtonText}" Command="{Binding CancelOrStopRuntimeCommand}" Width="82" Height="34" />
                    </StackPanel>
                    <TextBlock Text="Push-to-talk is still available for testing. Start Listen is now the normal hands-free voice mode." TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8" />
                    <TextBlock Text="Speech Status" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SpeechStatus}" TextWrapping="Wrap" Foreground="#666" Margin="0,2,0,8" />
                    <Separator Margin="0,8,0,8" />
                    <TextBlock Text="Screen Awareness" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Start Screen" Command="{Binding StartScreenAwarenessCommand}" Width="92" Height="30" Margin="0,0,6,0" />
                        <Button Content="Stop" Command="{Binding StopScreenAwarenessCommand}" Width="64" Height="30" Margin="0,0,6,0" />
                        <Button Content="Capture Now" Command="{Binding CaptureScreenNowCommand}" Width="94" Height="30" />
                    </StackPanel>
                    <TextBlock Text="Every 5 minutes it captures the whole desktop, summarizes it with the configured screen model, keeps the latest 5 summaries, and passes them into the Star prompt." TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6" />
                    <TextBlock Text="Screen Status" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ScreenStatus}" TextWrapping="Wrap" Foreground="#333" Margin="0,2,0,8" />
                    <Separator Margin="0,8,0,8" />
                    <TextBlock Text="Voice Output" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Audio Backend" FontWeight="SemiBold" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding AudioBackends}"
                              SelectedItem="{Binding SelectedAudioBackend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,6" Height="30" />
                    <TextBlock Text="Default is directsound. Use wasapi when Windows shared-mode audio is healthy and you want the modern output path; use waveout as the legacy fallback." TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8" />
                    <Button Content="Play Elusiaa Clone WAV" Command="{Binding PlayElusiaaCloneWavCommand}" Margin="0,0,0,8" Height="34" />
                    <TextBlock Text="This plays src\Wds.SixStars.Api\Content\VoiceClones\elusiaa_clone.wav directly through NAudio using the selected audio backend, bypassing LLM, Qwen, WebSocket TTS, and HTTP TTS." TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8" />
                    <TextBlock Text="Default desktop mode uses WebSocket streaming TTS so Star replies can begin playing chunk-by-chunk. The old HTTP /v1/audio/speech generator is disabled in this desktop harness." TextWrapping="Wrap" Foreground="#666" />
                </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <Button Content="Send Current Request" Command="{Binding SendCommand}" Width="150" Height="38" DockPanel.Dock="Left" />
            <Button Content="Send Message" Command="{Binding SendMessageCommand}" Width="130" Height="38" Margin="8,0,0,0" DockPanel.Dock="Left" />
            <Button Content="Tell Me A Story" Command="{Binding TellStoryCommand}" Width="140" Height="38" Margin="8,0,0,0" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding Status}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#555" />
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Star Spoken Output">
                <TextBox Text="{Binding StarOutput}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="15"
                         Padding="10" />
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Debug JSON / Unity Payload">
                <TextBox Text="{Binding DebugJson}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="10" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>
