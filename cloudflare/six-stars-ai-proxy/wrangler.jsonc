{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-last-cat-six-stars-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "secrets": {
    "required": [
      "GEMINI_API_KEY",
      "GROQ_API_KEY",
      "DASHSCOPE_API_KEY",
      "APP_PROXY_TOKEN"
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "six_stars_ai_proxy_usage"
    }
  ]
}
